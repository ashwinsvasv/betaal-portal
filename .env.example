# Google sign-in (create at https://console.cloud.google.com/apis/credentials -> OAuth client ID, Web)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Who may sign in: comma-separated domains and/or extra emails
SUNWAI_ALLOWED_DOMAINS=iiml.ac.in
SUNWAI_ALLOWED_EMAILS=
# Sign in a real Google account as a seeded council member: email=userId,email=userId
# Example: ashwinsvasv@gmail.com=user-pres
SUNWAI_ROLE_MAP=ashwinsvasv@gmail.com=user-pres

# Email. Set EMAIL_LIVE=true and SMTP creds to really send; otherwise sends are logged only.
# Gmail: enable 2-step verification, then create an App Password (https://myaccount.google.com/apppasswords)
EMAIL_LIVE=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=ashwinsvasv@gmail.com
SMTP_PASS=
EMAIL_FROM=Betaal <ashwinsvasv@gmail.com>
# Sandbox: every email is delivered to this mailbox as +role (e.g. ashwinsvasv+president@gmail.com).
# Remove this line to send to real recipients (requires a signed-in user).
EMAIL_SANDBOX_MAILBOX=ashwinsvasv@gmail.com

# Set to true ONLY for demos/tests: shows one-click demo logins (never in production)
NEXT_PUBLIC_DEMO_MODE=false

# Protects /api/cron/* (Vercel Cron sends it automatically). Generate: openssl rand -base64 32
CRON_SECRET=

# Supabase (server-side only; never prefix with NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
